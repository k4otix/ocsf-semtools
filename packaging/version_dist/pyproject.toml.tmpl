# Rendered by `make generate` (packaging/version_dist/dist.py render); do not edit.
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "@DIST@"
version = "@VERSION@"
description = "Typed msgspec models for OCSF @OCSF@, generated by ocsf-semtools @VERSION@."
readme = "README.md"
license = "Apache-2.0"
license-files = ["LICENSE", "NOTICE"]
requires-python = ">=3.12"
authors = [{ name = "Eddie Allan" }]
keywords = ["ocsf", "open-cybersecurity-schema-framework", "security", "msgspec", "models"]
# The core that generated this tree, up to its next generated-code contract break: core
# releases that leave this tree unchanged don't republish it, and upgrading core alone works.
dependencies = ["ocsf-semtools@CORE@", "msgspec>=0.22,<1"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Topic :: Security",
    "Typing :: Typed",
]

[project.urls]
Documentation = "https://github.com/k4otix/ocsf-semtools/blob/main/docs/models.md"
Repository = "https://github.com/k4otix/ocsf-semtools"
Issues = "https://github.com/k4otix/ocsf-semtools/issues"

[tool.hatch.build.targets.wheel]
packages = ["@PACKAGE@"]
