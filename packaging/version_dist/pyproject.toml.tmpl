# Rendered by `make generate` (packaging/version_dist/dist.py render); do not edit.
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "@DIST@"
version = "@VERSION@"
description = "Typed msgspec models for OCSF @OCSF@, generated by ocsf-toolkit @VERSION@."
readme = "README.md"
license = "Apache-2.0"
license-files = ["LICENSE"]
requires-python = ">=3.12"
# The core that generated this tree, up to its next generated-code contract break: core
# releases that leave this tree unchanged don't republish it, and upgrading core alone works.
dependencies = ["ocsf-toolkit@CORE@", "msgspec>=0.22,<1"]
classifiers = [
    "Programming Language :: Python :: 3",
    "Topic :: Security",
    "Typing :: Typed",
]

[project.urls]
Repository = "https://github.com/k4otix/ocsf-toolkit"

[tool.hatch.build.targets.wheel]
packages = ["@PACKAGE@"]
