# Rendered by `make generate` from packaging/version_dist/pyproject.toml.tmpl; do not edit.
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "@DIST@"
version = "@VERSION@"
description = "Typed msgspec models for OCSF @OCSF@, generated by ocsf-toolkit @VERSION@."
readme = "README.md"
license = "Apache-2.0"
requires-python = ">=3.12"
# The generated code is a function of the generator, so the core is pinned exactly.
dependencies = ["ocsf-toolkit==@VERSION@", "msgspec>=0.22,<1"]
classifiers = [
    "Programming Language :: Python :: 3",
    "Topic :: Security",
    "Typing :: Typed",
]

[project.urls]
Repository = "https://github.com/k4otix/ocsf-toolkit"

[tool.hatch.build.targets.wheel]
packages = ["@PACKAGE@"]
